# The fang-thumbs container: FaNG's thumbnail worker with libvips (libheif, ImageMagick, SVG, JPEG XL),
# FFmpeg and ExifTool. Build from the repo root: docker build -f docker/Dockerfile.thumbs .

FROM swift:6.2-bookworm AS swift
WORKDIR /src
COPY Package.swift Package.resolved ./
RUN swift package resolve
COPY Sources Sources
COPY Tests Tests
RUN swift build -c release --static-swift-stdlib --product fang-thumbs && cp .build/release/fang-thumbs /

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini libvips-tools libheif-plugin-libde265 libheif-plugin-dav1d libheif-plugin-aomdec \
        ffmpeg libimage-exiftool-perl icnsutils libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=swift /fang-thumbs /usr/local/bin/
RUN ! (ldd /usr/local/bin/fang-thumbs | grep "not found") && vips --vips-config | head -3
# Unprivileged, as the host's owner of the files (Unraid: 99:100), which can read them.
# Runs as the host's 99:100 (thumbnails it writes are the host's), with one capability kept: reading any file
# (CAP_DAC_READ_SEARCH), so a folder or file with restrictive modes (root-owned, 0700) still gets thumbnails.
# The shares are mounted read-only, and every other capability is dropped.
ENTRYPOINT ["/usr/bin/tini", "--", "setpriv", "--reuid=99", "--regid=100", "--clear-groups", \
            "--inh-caps=-all,+dac_read_search", "--ambient-caps=-all,+dac_read_search", "--bounding-set=-all,+dac_read_search"]
CMD ["/usr/local/bin/fang-thumbs"]
