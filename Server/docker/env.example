# Settings for docker-compose.yml. Keep this file private (it holds the database password).
FANG_DB_PASSWORD=change-me
# Docker network on the LAN (macvlan/ipvlan) and FaNG's own address on it: a free address on your LAN, outside
# your router's DHCP range. Unraid: br0 (already exists). Elsewhere create one first (see the README).
FANG_LAN_NETWORK=fang-lan
FANG_IP=192.0.2.10
# The API's port. Leave it at 443 with an address of its own (above); see the README for running without one.
# FANG_HTTPS_PORT=443
# What FaNG can see, and where it appears in the container. To serve folders from several pools, mount /mnt
# (FANG_SHARE_SOURCE=/mnt, FANG_SHARE_TARGET=/mnt) and pick the shares in the admin page (https://<FANG_IP>/admin):
# use pool or disk paths (/mnt/<pool>/...), not /mnt/user (Unraid's user shares don't report changes or allow
# reflinks). Shares are listed in fang/config/shares.conf as name|path|0664|0775|versions.
FANG_SHARE_SOURCE=/path/on/host
FANG_SHARE_TARGET=/data
# Where thumbnails are kept (an SSD is best); defaults to ./thumbnails next to the compose file.
FANG_THUMBNAILS=./thumbnails
# PostgreSQL's memory cache (shared_buffers); defaults to 4GB.
FANG_DB_CACHE=4GB
# Memory ceilings per container (the host keeps the rest; workers size themselves to these and the CPUs).
FANG_MEMORY=16g
FANG_THUMBS_MEMORY=24g
FANG_DB_MEMORY=12g
# Thumbnail workers; empty sizes them to the host.
FANG_THUMB_WORKERS=
# Retention: versions are thinned (all for a day, hourly for a week, daily for a month, weekly up to this many
# days; 0 keeps monthly ones forever). Records of deleted items are kept this many days for devices that
# haven't synced (older ones list everything again).
FANG_VERSION_DAYS=365
FANG_DELETED_RECORD_DAYS=30

# Unraid's Docker page: open the admin page from the container's menu, and show FaNG's icon.
# FANG_ADMIN_URL=https://<fang's address>/admin
# FANG_ICON_URL=https://<fang's address>/admin/icon.png
